  // With both S and F disabled, mstatus.FS must be read-only zero. Sail's
  // validator enforces the consistency rather than silently accepting a
  // machine that claims a floating-point context it cannot have.

  // S and U are DISABLED: this core is M-mode only (PROJECT_CONTEXT decision
  // D1, ADR-0003). The two ExtContext_Off settings below are the correct
  // consequence, not a workaround - with no supervisor mode, no F extension
  // and no vector registers, mstatus.FS and mstatus.VS must be read-only zero.
  // Sail's validator enforces that rather than accepting a machine that claims
  // a floating-point or vector context it cannot have.
  "base": {
    "mstatus": {
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },
    // misa is READ-ONLY in this core (docs/results/0009-csr-standalone.md).
    // The spec permits writing it to disable extensions; no real core does,
    // and read-only is simpler.
    "writable_misa": false
  }
